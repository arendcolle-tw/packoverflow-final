#!/usr/bin/env python3
"""Score the seeded voice demo topics with Albéric's ranking and write app/voice/demo-answer.json.

The demo topics (payroll export retries, PC 200 indexation, sick leave, onboarding, DmfA, contract changes, pay
transparency) are seeded, labeled demo data with made-up colleagues. Their answers come from the same code as the
live graph (ideas/alberic), never from a second copy in app/. No .py extension, so Cloud Run buildpacks keep app/ Node.
Run from the repo root after editing demo-rows.json or demo-topics.json:  python3 app/voice/build-demo
"""

import json
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "ideas" / "alberic"))

from knowledge_graph.graph import KnowledgeGraph  # noqa: E402
from proficiency.score import who_knows  # noqa: E402

AT = datetime(2026, 10, 20, 9, 0, tzinfo=timezone.utc)
HERE = ROOT / "app" / "voice"
topics = json.loads((HERE / "demo-topics.json").read_text())

with tempfile.TemporaryDirectory() as tmp:
    graph = KnowledgeGraph(Path(tmp) / "demo.sqlite", seed_paths=[HERE / "demo-rows.json"])
    rows = graph.rows()
    risks = {r["topic"]: r for r in graph.risks(at=AT)}

out = {"rows": rows, "topics": []}
for t in topics:
    answer = who_knows(t["question"], [r for r in rows if r["topic"] == t["id"]], AT)
    out["topics"].append({**t, "who_knows": answer, "risk": risks[t["id"]]})
    print(t["id"], answer["status"], answer["owner"], risks[t["id"]]["status"])
(HERE / "demo-answer.json").write_text(json.dumps(out, indent=1) + "\n")
